root = true

[*.cs]
# Keep using directives outside the namespace, matching the SDK templates.
dotnet_diagnostic.SA1200.severity = none

# File headers are covered by the repository license.
dotnet_diagnostic.SA1633.severity = none

# Write XML documentation where it clarifies an API or a non-obvious contract.
dotnet_diagnostic.SA1600.severity = none
dotnet_diagnostic.CS1591.severity = none

# Japanese XML comments use Japanese punctuation.
dotnet_diagnostic.SA1629.severity = none
